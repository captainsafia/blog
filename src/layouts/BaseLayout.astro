---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import '../styles/style.css';
import '../styles/syntax.css';
import { getAccentColor } from '../utils/accent';

// Accent colors seeded from the build date; the inline script below re-seeds
// them from the visitor's current date so the color changes daily even without
// a rebuild.
const { accent, accentDark } = getAccentColor();

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  date?: Date;
  modifiedDate?: Date;
}

const { title, description, ogImage, date, modifiedDate } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-us">
  <head>
    <Head 
      title={title} 
      description={description} 
      ogImage={ogImage}
      date={date}
      modifiedDate={modifiedDate}
    />
    <style is:inline set:html={`html:root { --accent: ${accent}; --accent-dark: ${accentDark}; }`} />
    <script is:inline>
      // Daily accent color: deterministic PRNG seeded from today's date (UTC).
      // Keep in sync with src/utils/accent.ts, which this mirrors for the client.
      (function () {
        var d = new Date();
        var seed = 2166136261;
        var dateKey = d.getUTCFullYear() + '-' + (d.getUTCMonth() + 1) + '-' + d.getUTCDate();
        for (var i = 0; i < dateKey.length; i++) {
          seed ^= dateKey.charCodeAt(i);
          seed = Math.imul(seed, 16777619);
        }
        seed = seed >>> 0;
        seed = (seed + 0x6d2b79f5) | 0;
        var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        var rand = ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        var hue = Math.floor(rand * 360);
        function hslToHex(h, s, l) {
          s /= 100; l /= 100;
          var k = function (n) { return (n + h / 30) % 12; };
          var a = s * Math.min(l, 1 - l);
          var f = function (n) {
            return l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
          };
          var to255 = function (x) {
            return Math.round(255 * x).toString(16).padStart(2, '0');
          };
          return '#' + to255(f(0)) + to255(f(8)) + to255(f(4));
        }
        var root = document.documentElement;
        root.style.setProperty('--accent', hslToHex(hue, 45, 40));
        root.style.setProperty('--accent-dark', hslToHex(hue, 45, 30));
      })();
    </script>
  </head>

  <body>
    <Header />

    <main class="content container" id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
